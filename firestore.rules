rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function friendRequestPath(a, b) {
      return /databases/$(database)/documents/friendRequests/$(a + '__' + b);
    }

    function areFriends(a, b) {
      return (exists(friendRequestPath(a, b))
              && get(friendRequestPath(a, b)).data.status == 'accepted')
          || (exists(friendRequestPath(b, a))
              && get(friendRequestPath(b, a)).data.status == 'accepted');
    }

    function isThreadMember(threadId) {
      return signedIn()
        && exists(/databases/$(database)/documents/threads/$(threadId))
        && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participantUids;
    }

    match /users/{userId} {
      // User documents contain public profile fields only (uid, name, avatar).
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'name', 'avatar', 'createdAt', 'updatedAt']);
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar', 'updatedAt']);
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.requesterUid == request.auth.uid
            || resource.data.recipientUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && requestId == request.resource.data.requesterUid + '__' + request.resource.data.recipientUid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.recipientUid));

      // Receiver can accept/reject a pending request. A sender can re-send after rejection.
      allow update: if signedIn()
        && request.resource.data.requesterUid == resource.data.requesterUid
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.status == 'pending'
        && requestId == resource.data.requesterUid + '__' + resource.data.recipientUid
        && (
          (resource.data.recipientUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'rejected']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
          ||
          (resource.data.requesterUid == request.auth.uid
            && resource.data.status == 'rejected'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'createdAt']))
        );

      allow delete: if signedIn()
        && resource.data.requesterUid == request.auth.uid
        && resource.data.status == 'pending';
    }

    match /threads/{threadId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn()
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.auth.uid in request.resource.data.participantUids
        && areFriends(request.resource.data.participantUids[0], request.resource.data.participantUids[1]);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.participantUids == resource.data.participantUids;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isThreadMember(threadId);
        allow create: if isThreadMember(threadId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.recipientUid in get(/databases/$(database)/documents/threads/$(threadId)).data.participantUids
          && request.resource.data.recipientUid != request.auth.uid
          && areFriends(request.auth.uid, request.resource.data.recipientUid)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }
    }
  }
}
